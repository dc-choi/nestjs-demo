{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "\\.e2e\\.test\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.jest.json" }]
    },
    "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1",
        "^~/(.*)$": "<rootDir>/src/$1",
        "^test/(.*)$": "<rootDir>/test/$1"
    }
}
