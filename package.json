        "@nestjs/apollo": "13.4.4",
        "@nestjs/common": "^11.1.29",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.29",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/graphql": "13.4.4",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.29",
        "@prisma/adapter-mariadb": "7.9.1",
        "@prisma/client": "7.9.1",
        "@prisma/extension-read-replicas": "0.5.0",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.47",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.4.2",
        "graphql": "16.14.2",
        "handlebars": "^4.7.9",
        "ioredis": "^6.0.0",
        "joi": "^18.2.3",
        "kysely": "0.28.17",
        "nest-winston": "^1.10.2",
        "nestjs-cls": "6.2.1",
        "nodemailer": "^9.0.5",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "prisma": "7.9.1",
        "prisma-extension-kysely": "4.0.0",
        "prisma-kysely": "3.1.1",
        "redlock": "^4.2.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "rxjs": "^7.8.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
