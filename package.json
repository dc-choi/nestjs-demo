{
    "name": "demo-server",
    "version": "0.0.1",
    "description": "demo-server",
    "author": "Dong Chul Choi",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=26.7.0 <27"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "dev": "pnpm prebuild && prisma generate && nest start -w",
        "stage:build": "prisma generate && nest build",
        "stage:boot": "nest start -w",
        "stage": "pnpm prebuild && pnpm stage:build && pnpm stage:boot",
        "prod:build": "prisma generate && swc src prisma --out-dir dist && mkdir -p dist/src/global && cp -R src/global/templates dist/src/global/",
        "prod:boot": "node dist/src/main.js",
        "prod": "pnpm prebuild && pnpm prod:build && pnpm prod:boot",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "test": "NODE_ENV=test jest --forceExit",
        "coverage": "NODE_ENV=test jest --coverage",
        "unit": "NODE_ENV=test jest --forceExit test/unit",
        "integration": "NODE_ENV=test jest --forceExit test/integration",
        "e2e": "NODE_ENV=test jest --forceExit --config jest.e2e.config.json test/e2e"
    },
    "dependencies": {
        "@apollo/server": "5.5.1",
        "@as-integrations/express5": "1.1.2",
