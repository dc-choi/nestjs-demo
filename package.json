    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
