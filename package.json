{
    "name": "demo-server",
    "version": "0.0.1",
    "description": "demo-server",
    "author": "Dong Chul Choi",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=26.7.0 <27"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "dev": "pnpm prebuild && nest start -w",
        "stage:build": "nest build",
        "stage:boot": "nest start -w",
        "stage": "pnpm prebuild && pnpm stage:build && pnpm stage:boot",
        "prod:build": "rimraf dist && swc src --out-dir dist && mkdir -p dist/src/global && cp -R src/global/templates dist/src/global/",
        "prod:boot": "node dist/src/main.js",
        "prod": "pnpm prod:build && pnpm prod:boot",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --forceExit && pnpm unit:mikroorm",
        "coverage": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageDirectory coverage/mikroorm --config jest.mikro-orm.config.json",
        "unit": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --forceExit test/unit && pnpm unit:mikroorm",
        "unit:mikroorm": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --forceExit --config jest.mikro-orm.config.json",
        "database:schema:dump": "mikro-orm schema:update --dump --safe --no-drop-tables",
        "database:migration:create": "mikro-orm migration:create",
        "database:migration:check": "mikro-orm migration:check",
        "database:migration:pending": "mikro-orm migration:pending",
        "database:migrate": "mikro-orm migration:up",
        "database:migrate:down": "mikro-orm migration:down",
        "database:migrate:prod": "node dist/src/infra/database/run-migrations.js",
        "database:seed": "mikro-orm seeder:run",
        "inventory:expire": "node dist/src/cli/inventory-expire.js",
        "search:rebuild": "node dist/src/cli/search-rebuild.js",
        "search:outbox:drain": "node dist/src/cli/search-outbox-relay.js",
        "search:reconcile": "node dist/src/cli/search-reconcile.js",
        "search:evaluate": "node dist/src/cli/search-evaluate.js",
        "integration": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --forceExit test/integration",
        "integration:mysql": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules MYSQL_INTEGRATION=1 jest --runInBand --forceExit --config jest.mikro-orm.config.json test/integration/database",
        "integration:opensearch": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules OPENSEARCH_INTEGRATION=1 jest --runInBand --forceExit test/integration/search",
        "integration:search-pipeline": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules MYSQL_INTEGRATION=1 OPENSEARCH_INTEGRATION=1 jest --runInBand --forceExit --config jest.mikro-orm.config.json test/integration/database/search-pipeline.mysql-opensearch.integration.test.ts",
        "e2e": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --forceExit --config jest.e2e.config.json test/e2e"
    },
    "dependencies": {
        "@apollo/server": "5.5.1",
        "@as-integrations/express5": "1.1.2",
        "@mikro-orm/core": "7.1.11",
        "@mikro-orm/decorators": "7.1.11",
        "@mikro-orm/migrations": "7.1.11",
        "@mikro-orm/mysql": "7.1.11",
        "@mikro-orm/nestjs": "7.1.0",
        "@nestjs-modules/mailer": "^2.3.7",
        "@nestjs/apollo": "14.0.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/cqrs": "^12.0.0",
        "@nestjs/graphql": "14.0.0",
        "@nestjs/jwt": "^12.0.1",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.47",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.4.2",
        "graphql": "16.14.2",
        "handlebars": "^4.7.9",
        "ioredis": "^6.0.0",
        "joi": "^18.2.3",
        "nodemailer": "^9.0.5",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "redlock": "^4.2.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "rxjs": "^7.8.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "30.5.1",
        "@mikro-orm/cli": "7.1.11",
        "@mikro-orm/entity-generator": "7.1.11",
        "@mikro-orm/seeder": "7.1.11",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@swc-node/register": "1.12.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@types/nodemailer": "^8.0.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/redlock": "4.0.8",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.1",
        "globals": "^16.2.0",
        "jest": "^30.5.1",
        "prettier": "^3.5.3",
        "ts-jest": "^29.4.12",
        "typescript": "6.0.3"
    },
    "mikro-orm": {
        "configPaths": [
            "./mikro-orm.config.ts"
        ],
        "preferTs": true,
        "tsLoader": "swc",
        "tsConfigPath": "./tsconfig.json"
    }
}
