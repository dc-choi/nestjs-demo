/// 주문에서 한 번에 포장하고 발송하는 배송 단위다. 한 주문이 여러 Fulfillment를 가져 분할 배송을 표현한다.
/// 현재 상태와 상태별 시각은 배송 상태 전이 규칙에 따라 함께 갱신해야 하며, 운송장 인덱스는 유일성을 보장하지 않는다.
model Fulfillment {
  id             BigInt            @id @default(autoincrement()) @db.BigInt
  status         FulfillmentStatus @default(PENDING)
  carrier        String?           @db.VarChar(128)
  trackingNumber String?           @map("tracking_number") @db.VarChar(255)
  packedAt       DateTime?         @map("packed_at") @db.DateTime(3)
  shippedAt      DateTime?         @map("shipped_at") @db.DateTime(3)
  deliveredAt    DateTime?         @map("delivered_at") @db.DateTime(3)
  cancelledAt    DateTime?         @map("cancelled_at") @db.DateTime(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderId BigInt @map("order_id") @db.BigInt

  FulfillmentItem FulfillmentItem[]

  @@index([orderId, status])
  @@index([carrier, trackingNumber])
  @@map("fulfillments")
}

/// 주문 품목 수량 중 이 배송에 배정된 수량을 나타내며, 같은 주문 품목을 여러 배송으로 나누어 부분 배송할 수 있다.
/// 복합 unique는 한 배송 안의 중복 행만 막는다. 양수 수량, 같은 주문 소속, 취소되지 않은 배송의 누적 수량 한도는 애플리케이션이 검증해야 한다.
model FulfillmentItem {
  id       BigInt @id @default(autoincrement()) @db.BigInt
  quantity Int    @db.Int

  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fulfillmentId BigInt      @map("fulfillment_id") @db.BigInt

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItemId BigInt    @map("order_item_id") @db.BigInt

  @@unique([fulfillmentId, orderItemId])
  @@index([orderItemId])
  @@map("fulfillment_items")
}

enum FulfillmentStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}
