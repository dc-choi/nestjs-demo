// snapshot 옵션 관계 구조
//
// ProductSnapshot 1 -> N ProductSnapshotOption 1 -> N ProductSnapshotOptionValue
// ProductSnapshotItem N <-> N ProductSnapshotOptionValue (ProductSnapshotItemOptionValue가 연결)
//
// 발행 전에 모든 required option이 각 SKU에 정확히 하나씩 선택됐는지, optionSignature가 정렬된
// option/value code 쌍과 일치하는지 검증한다. 발행 뒤에는 옵션 subtree를 수정하거나 삭제하지 않는다.

/// 색상이나 크기처럼 한 상품 snapshot의 SKU 조합을 결정하는 선택 축이다.
model ProductSnapshotOption {
  id                BigInt  @id @default(autoincrement()) @db.BigInt
  /// 표시명이 바뀌어도 optionSignature 계산에 사용할 snapshot 내부의 안정적인 코드다.
  code              String  @db.VarChar(64)
  name              String  @db.VarChar(255)
  isRequired        Boolean @default(true) @map("is_required")
  sequence          Int     @db.UnsignedInt
  productSnapshotId BigInt  @map("product_snapshot_id") @db.BigInt

  snapshot   ProductSnapshot                  @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  values     ProductSnapshotOptionValue[]
  selections ProductSnapshotItemOptionValue[]

  /// 선택 관계의 복합 FK가 option과 snapshot 소속을 함께 검증할 수 있게 한다.
  @@unique([id, productSnapshotId])
  /// 같은 snapshot 안에서 코드, 이름, 표시 순서가 충돌하지 않도록 한다.
  @@unique([productSnapshotId, code])
  @@unique([productSnapshotId, name])
  @@unique([productSnapshotId, sequence])
  @@map("product_snapshot_options")
}

/// snapshot 옵션 하나에서 선택할 수 있는 값이다.
/// 표시명과 별도로 code를 두어 이름을 바꿔도 서명 계산 규칙이 명확하게 유지되도록 한다.
model ProductSnapshotOptionValue {
  id                      BigInt @id @default(autoincrement()) @db.BigInt
  code                    String @db.VarChar(64)
  name                    String @db.VarChar(255)
  sequence                Int    @db.UnsignedInt
  productSnapshotOptionId BigInt @map("product_snapshot_option_id") @db.BigInt

  option     ProductSnapshotOption            @relation(fields: [productSnapshotOptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selections ProductSnapshotItemOptionValue[]

  /// 선택 관계의 복합 FK가 값과 option 소속을 함께 검증할 수 있게 한다.
  @@unique([id, productSnapshotOptionId])
  @@unique([productSnapshotOptionId, code])
  @@unique([productSnapshotOptionId, name])
  @@unique([productSnapshotOptionId, sequence])
  @@map("product_snapshot_option_values")
}

/// 특정 snapshot의 SKU가 선택한 옵션 값을 연결한다.
/// 세 복합 FK로 SKU와 option이 같은 snapshot에 속하고 value가 그 option의 값인지 보장한다.
model ProductSnapshotItemOptionValue {
  productSnapshotId            BigInt @map("product_snapshot_id") @db.BigInt
  itemId                       BigInt @map("item_id") @db.BigInt
  productSnapshotOptionId      BigInt @map("product_snapshot_option_id") @db.BigInt
  productSnapshotOptionValueId BigInt @map("product_snapshot_option_value_id") @db.BigInt

  snapshotItem ProductSnapshotItem        @relation(fields: [productSnapshotId, itemId], references: [productSnapshotId, itemId], onDelete: Restrict, onUpdate: Cascade, map: "psiov_snapshot_item_fk")
  option       ProductSnapshotOption      @relation(fields: [productSnapshotOptionId, productSnapshotId], references: [id, productSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "psiov_option_fk")
  value        ProductSnapshotOptionValue @relation(fields: [productSnapshotOptionValueId, productSnapshotOptionId], references: [id, productSnapshotOptionId], onDelete: Restrict, onUpdate: Cascade, map: "psiov_value_fk")

  /// SKU 하나는 같은 option에서 값을 최대 하나만 선택할 수 있다.
  @@id([productSnapshotId, itemId, productSnapshotOptionId])
  @@index([productSnapshotOptionId, productSnapshotId], map: "psiov_option_idx")
  @@index([productSnapshotOptionValueId, productSnapshotOptionId], map: "psiov_value_idx")
  @@map("product_snapshot_item_option_values")
}
