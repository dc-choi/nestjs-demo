/// 한 주문에 대해 결제 제공자에게 시도한 결제 수명 주기의 현재 요약이다. 재시도는 별도 시도로 남길 수 있다.
/// 제공자와 멱등성 키의 unique 제약은 같은 외부 요청의 중복 생성을 막으므로 재시도에서도 키를 재사용해야 한다.
/// 승인, 매입, 환불 같은 개별 작업은 PaymentTransaction에 누적하고 webhook은 선택적으로 이 시도에 연결한다.
model PaymentAttempt {
  id                BigInt               @id @default(autoincrement()) @db.BigInt
  provider          String               @db.VarChar(64)
  method            String?              @db.VarChar(64)
  status            PaymentAttemptStatus @default(PENDING)
  requestedAmount   Decimal              @map("requested_amount") @db.Decimal(19, 3)
  currencyCode      String               @map("currency_code") @db.Char(3)
  idempotencyKey    String               @map("idempotency_key") @db.VarChar(128)
  providerPaymentId String?              @map("provider_payment_id") @db.VarChar(255)
  errorCode         String?              @map("error_code") @db.VarChar(128)
  errorMessage      String?              @map("error_message") @db.Text
  authorizedAt      DateTime?            @map("authorized_at") @db.DateTime(3)
  capturedAt        DateTime?            @map("captured_at") @db.DateTime(3)
  cancelledAt       DateTime?            @map("cancelled_at") @db.DateTime(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderId BigInt @map("order_id") @db.BigInt

  PaymentTransaction  PaymentTransaction[]
  PaymentWebhookEvent PaymentWebhookEvent[]

  @@unique([provider, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
  @@map("payment_attempts")
}

/// 승인, 매입, 환불, 승인 취소처럼 제공자에 요청한 개별 작업을 추가 방식으로 기록한다.
/// 시도 내부의 멱등성 키와 제공자 거래 식별자 unique 제약이 중복 반영을 막지만, 누적 매입과 환불 금액 한도는 애플리케이션이 검증한다.
model PaymentTransaction {
  id                    BigInt                   @id @default(autoincrement()) @db.BigInt
  type                  PaymentTransactionType
  status                PaymentTransactionStatus @default(PENDING)
  amount                Decimal                  @db.Decimal(19, 3)
  idempotencyKey        String                   @map("idempotency_key") @db.VarChar(128)
  providerTransactionId String?                  @map("provider_transaction_id") @db.VarChar(255)
  errorCode             String?                  @map("error_code") @db.VarChar(128)
  errorMessage          String?                  @map("error_message") @db.Text
  processedAt           DateTime?                @map("processed_at") @db.DateTime(3)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttemptId BigInt         @map("payment_attempt_id") @db.BigInt

  @@unique([paymentAttemptId, idempotencyKey])
  @@unique([paymentAttemptId, providerTransactionId])
  @@index([paymentAttemptId, status])
  @@map("payment_transactions")
}

/// 중복 수신을 식별하고 처리 결과를 추적하는 webhook 수신 기록이다. 제공자 이벤트 식별자는 제공자 범위에서 유일하다.
/// webhook이 결제 시도보다 먼저 도착할 수 있어 관계는 선택적이며, 연결과 상태 반영은 순서가 뒤바뀌어도 멱등하게 처리해야 한다.
/// 원문에는 비밀이나 개인정보가 포함될 수 있어 저장하지 않는다. payloadHash는 무결성 비교용이며 서명 검증을 대신하지 않는다.
model PaymentWebhookEvent {
  id              BigInt                    @id @default(autoincrement()) @db.BigInt
  provider        String                    @db.VarChar(64)
  providerEventId String                    @map("provider_event_id") @db.VarChar(255)
  payloadHash     String                    @map("payload_hash") @db.Char(64)
  status          PaymentWebhookEventStatus @default(RECEIVED)
  receivedAt      DateTime                  @default(now()) @map("received_at") @db.DateTime(3)
  processedAt     DateTime?                 @map("processed_at") @db.DateTime(3)
  errorMessage    String?                   @map("error_message") @db.Text

  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  paymentAttemptId BigInt?         @map("payment_attempt_id") @db.BigInt

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

enum PaymentAttemptStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  FAILED
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  REFUND
  VOID
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}
