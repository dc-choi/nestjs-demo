/// 상품에 안정적으로 소속되는 실제 재고 단위다.
/// SKU와 현재 재고만 직접 소유하며 이름, 가격, 세금, 판매 상태는 ProductSnapshotItem에서 버전 관리한다.
model Item {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  /// UUID v7 기본값과 DB unique 제약을 함께 사용해 외부 SKU 식별자의 중복을 차단한다.
  /// snapshot과 주문이 복사한 SKU의 원본 식별자가 바뀌지 않도록 생성 후에는 변경하지 않는다.
  sku       String    @unique @default(uuid(7)) @db.VarChar(255)
  /// 주문 가능한 현재 잔액이다. 재고 원장과 같은 주 DB 트랜잭션에서만 변경한다.
  stock     Int       @default(0) @db.Int
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  /// Product를 삭제해 SKU의 소속이 사라지지 않도록 삭제를 제한한다.
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId BigInt  @map("product_id") @db.BigInt

  snapshots          ProductSnapshotItem[]
  OrderItem          OrderItem[]
  inventoryMovements InventoryMovement[]

  /// ProductSnapshotItem의 복합 FK가 Item과 Product 소속을 함께 검증할 수 있게 한다.
  @@unique([id, productId])
  @@index([productId, deletedAt])
  @@map("items")
}
