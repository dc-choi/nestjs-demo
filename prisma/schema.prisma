// Prisma 다중 파일 스키마의 진입점이다.
// generator와 datasource 같은 전역 설정만 두고, 도메인 모델은 models/*.prisma에서 관리한다.

generator client {
  provider        = "prisma-client"
  output          = "./generated/client"
  moduleFormat    = "cjs"
  previewFeatures = ["relationJoins"]
}

generator kysely {
  provider     = "prisma-kysely"
  camelCase    = true
  enumFileName = "enums.ts"
}

datasource db {
  provider = "mysql"
}
