{
    "moduleFileExtensions": ["js", "json", "ts"],
    "extensionsToTreatAsEsm": [".ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "test/(unit|integration)/database/.*\\.test\\.ts$",
    "transform": {
        "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": "tsconfig.jest.esm.json" }]
    },
    "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1",
        "^~/(.*)$": "<rootDir>/src/$1",
        "^test/(.*)$": "<rootDir>/test/$1"
    }
}
