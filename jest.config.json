{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "test/(unit|integration)/.*\\.test\\.ts$",
    "testPathIgnorePatterns": ["/test/unit/database/", "/test/integration/database/"],
    "transform": {
        "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.jest.json" }]
    },
    "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1",
        "^~/(.*)$": "<rootDir>/src/$1",
        "^test/(.*)$": "<rootDir>/test/$1"
    }
}
