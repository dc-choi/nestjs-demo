ENV=dev
SERVER_PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=demo_nest
MYSQL_PASSWORD=demo_nest_local
MYSQL_DATABASE=demo_nest
MYSQL_READ_REPLICA_HOST=127.0.0.1
MYSQL_READ_REPLICA_PORT=3306
MYSQL_READ_REPLICA_USER=demo_nest
MYSQL_READ_REPLICA_PASSWORD=demo_nest_local
MYSQL_READ_REPLICA_DATABASE=demo_nest

SECRET=replace-with-a-long-random-application-secret

# Optional. When omitted, payment Webhook HMAC uses SECRET.
PAYMENT_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret

MAIL_USER=local@example.com
MAIL_PASSWORD=local-mail-password
MAIL_SIGNUP_ALERT_USER=local@example.com
REDIS_URL=redis://127.0.0.1:6379

OPENSEARCH_ENABLED=false
OPENSEARCH_NODE_URL=http://127.0.0.1:9200
OPENSEARCH_READ_ALIAS=catalog-products-read
OPENSEARCH_WRITE_ALIAS=catalog-products-write
OPENSEARCH_CURSOR_SECRET=replace-with-a-long-random-cursor-secret
OPENSEARCH_REQUEST_TIMEOUT_MS=5000

# Required only by pnpm database:seed.
DEMO_SEED_PASSWORD=replace-with-a-local-demo-password
